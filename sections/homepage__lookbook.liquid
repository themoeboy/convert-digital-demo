{% render 'section__lookbook', section: section %}

{% schema %}
{
  "name": "t:names.lookbook",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:settings.lookbook_heading_default",
    },
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "t:settings.lookbook_entry",
      "info": "This would not be used on Product Pages. On Product Pages, lookbooks containing the product are shown automatically (up to 2).",
      "metaobject_type": "lookbook"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.lookbook",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
