{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  render 'vite-tag', entry: 'react-sections.jsx'
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <react-section component="Lookbook">
    <script type="application/json" data-react-props>
      {
        "heading": {{ section.settings.heading | json }},
        "countLabel": {{ 'content.react_section_count' | t | json }},
        "incrementLabel": {{ 'content.react_section_increment' | t | json }}
      }
    </script>
    <div data-react-root>
      {%- if section.settings.heading != blank -%}
        <h2 class="react-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <p>{{ 'content.react_section_loading' | t }}</p>
    </div>
  </react-section>
</div>

{% stylesheet %}
  react-section {
    display: block;
  }

  .react-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.lookbook",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Hello from React"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.lookbook",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
